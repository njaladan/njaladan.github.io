---
layout: null
permalink: /feed.xml
sitemap: false
---
{%- assign books = site.books | sort: 'date' | reverse -%}
{%- assign cdata_end = ']]>' -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | smartify | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  {%- for book in books limit: 10 %}
  {%- assign title = book.title | smartify | strip_html | normalize_whitespace | xml_escape %}
  <entry>
    <title type="html">{{ title }}</title>
    <link href="{{ book.url | absolute_url }}" rel="alternate" type="text/html" title="{{ title }}"/>
    <published>{{ book.date | date_to_xmlschema }}</published>
    <updated>{{ book.date | date_to_xmlschema }}</updated>
    <id>{{ book.url | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ book.url | absolute_url | xml_escape }}"><![CDATA[{{ book.content | strip | replace: cdata_end, ']]]]><![CDATA[>' }}]]></content>
    {%- assign summary = book.excerpt | strip_html | normalize_whitespace %}
    {%- if summary != '' %}
    <summary type="html"><![CDATA[{{ summary | replace: cdata_end, ']]]]><![CDATA[>' }}]]></summary>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>

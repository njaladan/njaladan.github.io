{
  "name": "njaladan.github.io",
  "private": true,
  "scripts": {
    "serve": "bundle exec jekyll serve --livereload",
    "build": "bundle exec jekyll build",
    "format": "prettier --write \"**/*.{js,css,json}\"",
    "format:check": "prettier --check \"**/*.{js,css,json}\"",
    "lint": "eslint .",
    "lint:py": "ruff check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run lint:py && npm run build",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"tests/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
